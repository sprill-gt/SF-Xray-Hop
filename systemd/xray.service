[Unit]
Description=SF-Xray-Hop managed Xray
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=sfxray
Group=sfxray
UMask=0077
RuntimeDirectory=sf-xray-hop
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStartPre=+/usr/local/lib/sf-xray-hop/sf-xray-hop internal prepare-runtime
ExecStart=/usr/local/lib/sf-xray-hop/sf-xray-hop internal runtime
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillMode=control-group
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# ExecStartPre=+ prepares root-owned runtime files outside this sandbox.
ReadWritePaths=/var/log/sf-xray-hop/core
ReadOnlyPaths=/run/sf-xray-hop
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
LimitNOFILE=524288
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
