#!/usr/bin/env bash
# SF-Xray-Hop. The installed tree must be owned by root and not writable by others.
set -uo pipefail
umask 077
export LC_ALL=C.UTF-8
SFXH_CODE=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
if [[ -L ${BASH_SOURCE[0]} ]]; then
    SFXH_CODE=$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")
fi
if [[ ${SFXH_TEST_MODE:-0} != 1 ]]; then export PATH=/usr/sbin:/usr/bin:/sbin:/bin; fi
for module in common platform model product links core reality health transaction manager self install operations benchmark ui; do
    # shellcheck source=/dev/null
    source "$SFXH_CODE/lib/$module.sh" || exit 1
done
sf_paths
sf_main "$@"
exit $?
